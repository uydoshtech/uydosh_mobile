default_platform(:android)

platform :android do
  desc "Upload an AAB to Google Play (internal by default)"
  lane :upload_play do |options|
    aab_path = options[:aab_path] || "build/app/outputs/bundle/release/app-release.aab"
    track = options[:track] || "internal"
    release_status = options[:release_status] || "draft" # draft|completed|inProgress|halted
    version_name = options[:version_name]
    changelog = options[:changelog]

    # Flutter versionCode is the "+build" suffix in pubspec.yaml (e.g. 1.2.3+249 -> 249)
    version_code =
      begin
        pubspec = File.read("pubspec.yaml")
        match = pubspec.match(/^\s*version:\s*\d+\.\d+\.\d+\+(\d+)\s*$/)
        match ? match[1].to_i : nil
      rescue
        nil
      end

    if changelog && !changelog.to_s.strip.empty? && version_code
      changelog_dir = File.join("fastlane", "metadata", "android", "en-US", "changelogs")
      FileUtils.mkdir_p(changelog_dir)
      File.write(File.join(changelog_dir, "#{version_code}.txt"), changelog.to_s.strip + "\n")
    end

    supply(
      aab: aab_path,
      track: track,
      release_status: release_status,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: changelog.nil? || changelog.to_s.strip.empty?,
      metadata_path: "fastlane/metadata/android",
      version_name: version_name,
    )
  end
end

