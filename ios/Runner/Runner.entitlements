<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:api.uydosh.com</string>
		<string>applinks:scan.uydosh.com</string>
		<string>applinks:app3016986242-login.tg.dev</string>
		<string>webcredentials:app3016986242-login.tg.dev</string>
	</array>
	<!-- Sign in with Apple (App Review Guideline 4.8 — required because we
	     also offer Google Sign-In). The "Default" value scopes the
	     credential to this app's bundle ID; switch to "appBundleID" or a
	     services group only if we need to share SIWA state with siblings. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Required by App Review because this app ships with an App Clip:
	     the parent app must declare the App Clip's application identifier
	     (mirrors parent-application-identifiers in UyDoshAppClip.entitlements). -->
	<key>com.apple.developer.associated-appclip-app-identifiers</key>
	<array>
		<string>$(AppIdentifierPrefix)com.uydosh.app.Clip</string>
	</array>
</dict>
</plist>
