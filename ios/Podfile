        "    private func stopSession() {\n        isScanning = false\n        uydoshLiveDetectionOverlay?.setScanningActive(false, animated: true)"
      )

      # Process incremental CapturedRoom updates from RoomPlan.
      unless src.include?('func captureSession(_ session: RoomCaptureSession, didUpdate room: CapturedRoom)')
        src = src.sub(
          "    public func captureView(shouldPresent roomDataForProcessing: CapturedRoomData, error: Error?) -> Bool {\n        return true\n    }",
          [
            '    public func captureSession(_ session: RoomCaptureSession, didUpdate room: CapturedRoom) {',
            '        /* uydosh: quality heatmap RoomPlan fallback */',
            '        uydoshQualityHeatmap?.process(room: room)',
            '        uydoshLiveDetectionOverlay?.process(room: room, replaceStats: true)',
            '    }',
            '',
            '    /* uydosh: live detection didAdd/didChange */',
            '    public func captureSession(_ session: RoomCaptureSession, didAdd room: CapturedRoom) {',
            '        uydoshQualityHeatmap?.process(room: room)',
            '        uydoshLiveDetectionOverlay?.process(room: room, replaceStats: false)',
            '    }',
            '',
            '    public func captureSession(_ session: RoomCaptureSession, didChange room: CapturedRoom) {',
            '        uydoshQualityHeatmap?.process(room: room)',
            '        uydoshLiveDetectionOverlay?.process(room: room, replaceStats: false)',
            '    }',
            '',
            '    public func captureView(shouldPresent roomDataForProcessing: CapturedRoomData, error: Error?) -> Bool {',
            '        return true',
            '    }',
          ].join("\n")
        )
      end

      helper = [
        '',
        "    #{marker}",
        '    private func uydoshAddLiveDetectionOverlay() {',
        '        let overlay = RoomScanLiveDetectionOverlay(',
        '            strings: .localized(overrides: uydoshLiveDetectionStringOverrides ?? [:])',
        '        )',
        '        overlay.attach(to: view)',
        '        overlay.setScanningActive(false, animated: false)',
        '        uydoshLiveDetectionOverlay = overlay',
        '    }',
      ].join("\n")

      src = src.sub(
        '    private func resetScanningSession() {',
        "#{helper}\n    private func resetScanningSession() {"
      )

      File.write(room_capture_file, src)
    end
  end

  # Upgrade installs that only wired didUpdate: also toast from didAdd / didChange
  # (RoomPlan often adds objects there first; category refinements arrive later).
  if File.exist?(room_capture_file)
    src = File.read(room_capture_file)
    marker = '/* uydosh: live detection didAdd/didChange */'
    unless src.include?(marker)
      old = "    public func captureSession(_ session: RoomCaptureSession, didUpdate room: CapturedRoom) {\n        uydoshLiveDetectionOverlay?.process(room: room)\n    }"
      oldWithStats = "    public func captureSession(_ session: RoomCaptureSession, didUpdate room: CapturedRoom) {\n        uydoshLiveDetectionOverlay?.process(room: room, replaceStats: true)\n    }"
      replacement = [
        '    public func captureSession(_ session: RoomCaptureSession, didUpdate room: CapturedRoom) {',
        '        uydoshLiveDetectionOverlay?.process(room: room, replaceStats: true)',
        '    }',
        '',
        "    #{marker}",
        '    public func captureSession(_ session: RoomCaptureSession, didAdd room: CapturedRoom) {',
        '        uydoshLiveDetectionOverlay?.process(room: room, replaceStats: false)',
        '    }',
        '',
        '    public func captureSession(_ session: RoomCaptureSession, didChange room: CapturedRoom) {',
        '        // Category / transform refinements (e.g. box → television).',
        '        uydoshLiveDetectionOverlay?.process(room: room, replaceStats: false)',
        '    }',
      ].join("\n")
      if src.include?(old)
        src = src.sub(old, replacement)
        File.write(room_capture_file, src)
      elsif src.include?(oldWithStats)
        src = src.sub(oldWithStats, replacement)
        File.write(room_capture_file, src)
      end
    end
  end

  # Feed live RoomPlan geometry to the quality renderer. RoomCaptureView often
  # exposes no ARMeshAnchor even on LiDAR hardware, so this semantic fallback
  # prevents an empty heatmap and permanent 0% progress.
  if File.exist?(room_capture_file)
    src = File.read(room_capture_file)
    marker = '/* uydosh: quality heatmap RoomPlan fallback */'
    unless src.include?(marker)
      src = src.gsub(
        /^(\s*public func captureSession\(_ session: RoomCaptureSession, did(?:Update|Add|Change) room: CapturedRoom\) \{\n)/,
        "\\1        #{marker}\n        uydoshQualityHeatmap?.process(room: room)\n"
      )
      File.write(room_capture_file, src)
    end
  end

  # Post-scan results metrics card (perimeter / area / walls / windows / doors)
  # shown once RoomPlan presents the grey processed model.
  if File.exist?(room_capture_file)
    ensure_roomplan_results_overlay!

    src = File.read(room_capture_file)
    marker = '/* uydosh: results overlay */'
    unless src.include?(marker)
      src = src.sub(
        '    private var uydoshLiveDetectionOverlay: RoomScanLiveDetectionOverlay?',
        "    private var uydoshLiveDetectionOverlay: RoomScanLiveDetectionOverlay?\n\n    #{marker}\n    private var uydoshResultsOverlay: RoomScanResultsOverlay?"
      )

      src = src.sub(
        'uydoshAddLiveDetectionOverlay()',
        "uydoshAddLiveDetectionOverlay()\n        uydoshAddResultsOverlay()"
      )

      src = src.sub(
        '        uydoshLiveDetectionOverlay?.setScanningActive(true, animated: true)',
        "        uydoshLiveDetectionOverlay?.setScanningActive(true, animated: true)\n        uydoshResultsOverlay?.hide(animated: true)"
      )

      src = src.sub(
        "    public func captureView(didPresent processedResult: CapturedRoom, error: Error?) {\n        currentCapturedRoom = processedResult\n        capturedRoomArray.append(processedResult)\n        finishButton.isEnabled = true",
        "    public func captureView(didPresent processedResult: CapturedRoom, error: Error?) {\n        currentCapturedRoom = processedResult\n        capturedRoomArray.append(processedResult)\n        finishButton.isEnabled = true\n        uydoshResultsOverlay?.show(room: processedResult, animated: true)"
      )

      helper = [
        '',
        "    #{marker}",
        '    private func uydoshAddResultsOverlay() {',
        '        let overlay = RoomScanResultsOverlay(',
        '            strings: .localized(overrides: uydoshLiveDetectionStringOverrides ?? [:])',
        '        )',
        '        overlay.attach(to: view)',
        '        uydoshResultsOverlay = overlay',
        '    }',
      ].join("\n")

      src = src.sub(
        '    private func resetScanningSession() {',
        "#{helper}\n    private func resetScanningSession() {"
      )

      File.write(room_capture_file, src)
    end
  end
end
