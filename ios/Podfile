    end
  end

  # Live detection feed + stats HUD during RoomPlan capture.
  # Source: room_scan_kit RoomScanLiveDetectionOverlay.swift (synced above).
  if File.exist?(room_capture_file)
    ensure_roomplan_live_detection_overlay!

    src = File.read(room_capture_file)
    marker = '/* uydosh: live detection overlay */'
    unless src.include?(marker)
      src = src.sub(
