          '    public var uydoshPhotogrammetryPackageReady: ((URL) -> Void)?',
          '    private let uydoshPhotogrammetryCapture = PhotogrammetryCaptureSession()',
        ].join("\n")
      )
      src = src.sub(
        '        roomCaptureView.captureSession.run(configuration: roomCaptureSessionConfig)',
        [
          '        roomCaptureView.captureSession.run(configuration: roomCaptureSessionConfig)',
          '        try? uydoshPhotogrammetryCapture.start(',
          '            arSession: roomCaptureView.captureSession.arSession',
          '        )',
        ].join("\n")
      )
      src = src.sub(
        "    private func stopSession() {\n        isScanning = false",
        [
          '    private func stopSession() {',
          '        isScanning = false',
          '        uydoshPhotogrammetryCapture.stopCapturingFrames()',
        ].join("\n")
      )
      src = src.sub(
        '    public func captureView(didPresent processedResult: CapturedRoom, error: Error?) {',
        [
          '    public func captureView(didPresent processedResult: CapturedRoom, error: Error?) {',
          '        uydoshQualityHeatmap?.stop()',
          '        Task { [weak self] in',
          '            guard let self else { return }',
          '            if let package = try? await self.uydoshPhotogrammetryCapture.finish(room: processedResult) {',
          '                self.uydoshPhotogrammetryPackageReady?(package.archiveURL)',
          '                if let root = self.view.window?.rootViewController,',
          '                   let flutter = Self.uydoshFindFlutterViewController(in: root) {',
          '                    FlutterMethodChannel(',
          '                        name: "room_scan_kit/photogrammetry",',
          '                        binaryMessenger: flutter.binaryMessenger',
          '                    ).invokeMethod("onPackageReady", arguments: package.archiveURL.path)',
          '                }',
          '            }',
          '        }',
        ].join("\n")
      )
      File.write(room_capture_file, src)
    end
  end

  # Ensure the live heatmap cannot leak into RoomPlan's processed-result view,
  # including upgrades where the Phase 1 marker already exists.
  if File.exist?(room_capture_file)
    src = File.read(room_capture_file)
    needle = "    public func captureView(didPresent processedResult: CapturedRoom, error: Error?) {\n"
    unless src.include?("#{needle}        uydoshQualityHeatmap?.stop()\n")
      src = src.sub(needle, "#{needle}        uydoshQualityHeatmap?.stop()\n")
      File.write(room_capture_file, src)
    end
  end

  # Real-time scan quality heatmap. This is a transparent renderer over the
  # RoomCaptureView; RoomPlan keeps ownership of ARSession and its semantic
  # wall/object/door/window outlines remain enabled.
  if File.exist?(room_capture_file)
    ensure_roomplan_quality_heatmap!

    src = File.read(room_capture_file)
    marker = '/* uydosh: scan quality heatmap */'
    unless src.include?(marker)
