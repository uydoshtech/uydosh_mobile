        "    public var uydoshScanOtherRoomsTitle: String?\n\n    #{marker}\n    public var uydoshLiveDetectionStringOverrides: [String: String]?\n    private var uydoshLiveDetectionOverlay: RoomScanLiveDetectionOverlay?"
      )

      # Attach overlay after logo (or after RoomCaptureView if logo patch missing).
      if src.include?("uydoshAddLogoOverlay()\n        activityIndicator.stopAnimating()")
        src = src.sub(
          "uydoshAddLogoOverlay()\n        activityIndicator.stopAnimating()",
          "uydoshAddLogoOverlay()\n        uydoshAddLiveDetectionOverlay()\n        activityIndicator.stopAnimating()"
        )
      elsif src.include?("setupRoomCaptureView()\n        activityIndicator.stopAnimating()")
        src = src.sub(
          "setupRoomCaptureView()\n        activityIndicator.stopAnimating()",
          "setupRoomCaptureView()\n        uydoshAddLiveDetectionOverlay()\n        activityIndicator.stopAnimating()"
        )
      end

      # Reset + show while a capture session is running.
      src = src.sub(
        "    private func startSession() {\n\n        isScanning = true\n        roomCaptureView.captureSession.run(configuration: roomCaptureSessionConfig)",
        "    private func startSession() {\n\n        isScanning = true\n        uydoshLiveDetectionOverlay?.reset()\n        uydoshLiveDetectionOverlay?.setScanningActive(true, animated: true)\n        roomCaptureView.captureSession.run(configuration: roomCaptureSessionConfig)"
      )

      # Hide when capture stops (Done / post-process).
      src = src.sub(
