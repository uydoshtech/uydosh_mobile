  ensure_roomplan_kit_helper!('PhotogrammetryCapture.swift')
end

def ensure_roomplan_results_overlay!
  ensure_roomplan_kit_helper!('RoomScanResultsOverlay.swift')
end

ensure_roomplan_orientation_capture!
ensure_roomplan_live_detection_overlay!
ensure_roomplan_quality_heatmap!
ensure_roomplan_photogrammetry_capture!
