ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Yandex MapKit variant configuration
ENV['YANDEX_MAPKIT_VARIANT'] = 'lite'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Shared RoomPlan helpers live in room_scan_kit. flutter_roomplan's patched
# RoomCaptureViewController still needs them in the same module (Classes/**).
# Copy before CocoaPods indexes source_files so CI clean checkouts compile.
def ensure_roomplan_kit_helper!(filename)
  roomplan_classes = File.expand_path('.symlinks/plugins/flutter_roomplan/ios/Classes', __dir__)
  return nil unless Dir.exist?(roomplan_classes)

  dst = File.join(roomplan_classes, filename)
  # Prefer room_scan_kit (symlink / sibling) over a stale Runner/ copy.
  candidates = [
    File.expand_path(
      ".symlinks/plugins/room_scan_kit/ios/room_scan_kit/Sources/room_scan_kit/#{filename}",
      __dir__
    ),
    # Local path override (pubspec_overrides.yaml) — sibling checkout.
    File.expand_path(
      "../../room_scan_kit/ios/room_scan_kit/Sources/room_scan_kit/#{filename}",
      __dir__
    ),
    File.expand_path("Runner/#{filename}", __dir__),
  ]
  src = candidates.find { |path| File.exist?(path) }
  if src.nil?
    raise "#{filename} not found (tried: #{candidates.join(', ')})"
  end

  FileUtils.cp(src, dst)
  Pod::UI.puts "Synced #{filename} into flutter_roomplan from #{src}"
  dst
end

def ensure_roomplan_orientation_capture!
  ensure_roomplan_kit_helper!('RoomScanOrientationCapture.swift')
end

def ensure_roomplan_live_detection_overlay!
  ensure_roomplan_kit_helper!('RoomScanLiveDetectionOverlay.swift')
end

