# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Firebase Crashlytics build artifacts (dump_syms binary is downloaded per build)
.crashlytics/

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local API keys (prefer --dart-define=GEMINI_API_KEY=... in CI)
.env
.env.local

# Android signing - NEVER commit key.properties or keystore files
/android/key.properties
*.jks
*.keystore
