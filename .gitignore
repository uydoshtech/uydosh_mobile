# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.dart_tool/
.svn/
.flutter-plugins-dependencies
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# iOS / Xcode build artifacts.
#   - `ios/build/` is created when Flutter or Xcode resolves its derived-data
#     path into the ios/ directory. The `XCBuildData/PIFCache/` tree inside is
#     Xcode's content-addressed build-plan cache (one JSON per target, named
#     `TARGET@v11_hash=<sha>-json`). It's machine-generated and regenerated on
#     every build — never commit it.
#   - `ios/.last_build_id` is Flutter's "anything changed since last build?"
#     marker.
ios/build/
ios/.last_build_id

# FlutterFire CLI output — contains the iOS GOOGLE_APP_ID used by
# Crashlytics. Regenerated by `flutterfire configure`; keep it out of VCS so
# contributors don't stomp on each other's Firebase app IDs.
ios/firebase_app_id_file.json

# Symbolication related
app.*.symbols

# Firebase Crashlytics build artifacts (dump_syms binary is downloaded per build)
.crashlytics/

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local API keys (prefer --dart-define=GEMINI_API_KEY=... in CI)
.env
.env.local

# Android signing - NEVER commit key.properties or keystore files
/android/key.properties
*.jks
*.keystore

# Play Console "Android developer verification" token (account-specific)
/android/app/src/main/assets/adi-registration.properties

# Apple Developer .p8 keys (APNs / Sign in with Apple). Single-download
# private credentials — once leaked they cannot be re-protected, only
# revoked. Already burned us once: AuthKey_3X5CRF27LN.p8 was committed
# to history at c88df24. If a .p8 ever shows up here again, REVOKE the
# corresponding key in the Apple Developer portal before doing anything
# else.
*.p8
